create or replace function fn_buscar_colaboradores(termo text)
returns table (
    id_colaborador integer,
    nome varchar(100),
    email varchar(100),
    ativo boolean
) as $$
begin
    return query
    select c.id_colaborador, c.nome, c.email, c.ativo
    from colaboradores c
    where c.nome ilike '%' || termo || '%'
    or c.email ilike '%' || termo || '%';
end;
$$ language plpgsql;

create or replace view vw_painel_principal as
select
    c.nome as colaborador,
    t.titulo as tarefa,
    cat.nome as categoria,
    t.prazo_entrega,
    t.status
from tarefas t
join colaboradores c on c.id_colaborador = t.id_colaborador
join categorias cat on cat.id_categoria = t.id_categoria;

create or replace view vw_cronograma_prazos as
select
    t.titulo as tarefa,
    t.status,
    t.prazo_entrega,
    t.prazo_entrega - current_date as dias_restantes,
    c.nome as responsavel
from tarefas t
join colaboradores c on c.id_colaborador = t.id_colaborador
order by t.prazo_entrega asc;

