create or replace function fn_validar_tarefa()
returns trigger as $$
begin
    if not exists (
        select 1 from colaboradores
        where id = new.id_colaborador and ativo = true
    ) then
        raise exception 'Colaborador inativo';
    end if;

    new.data_criacao = now();
    return new;
end;
$$ language plpgsql;

create trigger trg_validar_tarefa
before insert on tarefas
for each row execute function fn_validar_tarefa();

create or replace function fn_historico()
returns trigger as $$
begin
    insert into historico_tarefas (id_tarefa, acao)
    values (new.id, 'Tarefa criada');
    return new;
end;
$$ language plpgsql;

create trigger trg_historico
after insert on tarefas
for each row execute function fn_historico();

