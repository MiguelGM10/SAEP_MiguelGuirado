create table clientes (
    id_cliente serial primary key,
    nome varchar(100) not null,
    email varchar(100) unique not null,
    cidade varchar(50)
);

create table setores (
    id_setor serial primary key,
    nome varchar(50) not null,
    andar integer
);

create table colaboradores (
    id_colaborador serial primary key,
    nome varchar(100) not null,
    email varchar(100) unique not null,
    senha varchar(100) not null,
    cargo varchar(50),
    ativo boolean default true,
    id_setor integer not null references setores(id_setor)
);

create table projetos (
    id_projeto serial primary key,
    nome varchar(100) not null,
    descricao text,
    data_inicio date,
    id_cliente integer not null references clientes(id_cliente)
);

create table categorias (
    id_categoria serial primary key,
    nome varchar(50) not null unique,
    descricao text
);

create table tarefas (
    id_tarefa serial primary key,
    titulo varchar(100) not null,
    descricao text,
    prazo_entrega date not null,
    status varchar(20) default 'Pendente',
    id_colaborador integer not null references colaboradores(id_colaborador),
    id_categoria integer not null references categorias(id_categoria),
    id_projeto integer not null references projetos(id_projeto),
    data_criacao timestamp default current_timestamp,
    check (status in ('Pendente', 'Em andamento', 'Concluída', 'Cancelada'))
);

create table historico_tarefas (
    id_historico serial primary key,
    id_tarefa integer not null references tarefas(id_tarefa),
    acao varchar(100) not null,
    data_registro timestamp default current_timestamp
);

