create or replace function fn_validar_tarefa()
returns trigger as $$
begin
    if not exists (
        select 1 from colaboradores
        where id_colaborador = new.id_colaborador
        and ativo = true
    ) then
        raise exception 'O colaborador não está ativo';
    end if;

    new.data_criacao = current_timestamp;

    return new;
end;
$$ language plpgsql;

create trigger trg_validar_tarefa
before insert on tarefas
for each row
execute function fn_validar_tarefa();

create or replace function fn_historico()
returns trigger as $$
begin
    insert into historico_tarefas (id_tarefa, acao)
    values (new.id_tarefa, 'Tarefa criada');

    return new;
end;
$$ language plpgsql;

create trigger trg_historico
after insert on tarefas
for each row
execute function fn_historico();

