create or replace function fn_buscar_colaboradores(termo text)
returns table (
    id integer,
    nome varchar(100),
    email varchar(100),
    ativo boolean
) as $$
begin
    return query
    select c.id, c.nome, c.email, c.ativo
    from colaboradores c
    where c.nome ilike '%' || termo || '%'
    or c.email ilike '%' || termo || '%';
end;
$$ language plpgsql;

create or replace view vw_painel_principal as
select c.nome as colaborador, t.titulo as tarefa,
       cat.nome as categoria, t.prazo, t.status
from tarefas t
join colaboradores c on c.id = t.id_colaborador
join categorias cat on cat.id = t.id_categoria;

create or replace view vw_cronograma_prazos as
select t.titulo as tarefa, t.status, t.prazo,
       t.prazo - current_date as dias_restantes,
       c.nome as responsavel
from tarefas t
join colaboradores c on c.id = t.id_colaborador
order by t.prazo;

